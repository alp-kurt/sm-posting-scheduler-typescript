{
  "name": "sm-posting-scheduler-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --max-warnings 0 && tsc --noEmit",
    "test": "npm run build && node --import ./scripts/load-env.mjs --test 'lib/**/*.test.js'",
    "predeploy": "npm run lint && npm run test",
    "check": "npm run predeploy",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-plugin-security": "^3.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
