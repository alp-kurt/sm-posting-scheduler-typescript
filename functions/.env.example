# =============================================================================
# Firebase Functions runtime env (loaded from functions/.env by the emulator /
# deploy tooling). For production secrets prefer Secret Manager:
#   firebase functions:secrets:set TOKEN_ENCRYPTION_KEY
# Mirror the same names as GitHub Actions secrets when wiring CI deploys.
# =============================================================================

# Required: 32-byte AES-256-GCM key as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Session cookie / store TTL
SESSION_TTL_HOURS=168

# Publish worker
PROCESSING_TIMEOUT_MS=900000
MAX_PUBLISH_RETRIES=3

# Media upload cap (bytes) — 100 MiB default
MEDIA_MAX_BYTES=104857600

# Set automatically by Node / Functions; used for secure cookies
# NODE_ENV=production
