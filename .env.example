# =============================================================================
# Repo / GitHub Actions / Firebase deploy secrets
# Copy to .env for local tooling only — never commit real values.
# In GitHub: Settings → Secrets and variables → Actions (names match below).
# =============================================================================

# Firebase project id (must match .firebaserc)
FIREBASE_PROJECT_ID=sm-posting-scheduler

# CI deploy auth — prefer a GCP service account JSON (base64) over a legacy token.
# Generate: gcloud iam service-accounts keys create key.json --iam-account=...
# Then: base64 -i key.json | pbcopy  → paste as secret FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT=
# Optional legacy alternative (firebase login:ci):
# FIREBASE_TOKEN=

# Hosting channel for preview deploys (PR workflow). Production uses "live".
FIREBASE_HOSTING_CHANNEL=live

# Region for Cloud Functions (must match functions/src/index.ts)
FIREBASE_FUNCTIONS_REGION=us-central1
